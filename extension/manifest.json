{
  "manifest_version": 3,
  "name": "Postdeck",
  "version": "1.0.0",
  "description": "Adds a button under every post on X that sends it to the Postdeck Mac app as a slide.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1:7678/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["post.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
